rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Uploads write bytes directly from the browser to Storage (so large
    // files don't have to pass through a serverless function), but only to
    // a path the server already reserved for this exact user + file:
    //   users/{uid}/files/{fileId}/{fileName}
    //
    // Before allowing the write, we cross-check the pending Firestore
    // metadata doc that /api/files/upload created: the caller must be the
    // doc's ownerId, and the doc must still be in the "uploading" state
    // (i.e. not already finalized or deleted). This mirrors the ownership
    // and quota-reservation checks the API already performed, so a client
    // cannot write to a path it was never issued.
    match /users/{uid}/files/{fileId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/files/$(fileId))
        && firestore.get(/databases/(default)/documents/files/$(fileId)).data.ownerId == uid
        && firestore.get(/databases/(default)/documents/files/$(fileId)).data.status == 'uploading';

      // No direct client reads, ever — public/private/link downloads are
      // all served through short-lived signed URLs minted server-side by
      // the Admin SDK in /api/download/[token], after visibility,
      // expiration, password, and usage-limit checks have run.
      allow read: if false;
    }

    // Everything else is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
