rules_version = '2';

// Mediary's application logic (quota enforcement, ownership checks, owner
// authorization, atomic link consumption, etc.) lives entirely in the
// server-side API routes, which use the Firebase Admin SDK — and the Admin
// SDK always bypasses Security Rules. These rules therefore exist as a
// hard backstop: the client SDK is never trusted to read or write Firestore
// directly, full stop. If a future feature needs direct client reads (e.g.
// live-updating a file list), add a narrow, explicitly-scoped rule for that
// one path instead of loosening this default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
